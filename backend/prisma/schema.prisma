// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  username       String         @unique
  password       String
  avatar         String?
  createdAt      DateTime       @default(now())
  
  predicciones   Prediccion[]
  puntos         Puntos?
  coleccion      ColeccionFiguritas[]
  transacciones  TransaccionPuntos[]
  ligasCreadas   LigaPrivada[]  @relation("LigaCreador")
  ligasMiembro   LigaPrivada[]  @relation("LigaMiembros")
  subscriptions  PushSubscription[]
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String?
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  
  user      User?    @relation(fields: [userId], references: [id])
}

model Prediccion {
  id             String   @id @default(uuid())
  userId         String
  partidoId      String   // ID del partido en football-data.org
  golesLocal     Int
  golesVisitante Int
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id])
}

model Puntos {
  id       String @id @default(cuid())
  userId   String @unique
  total    Int    @default(0)
  gastados Int    @default(0)
  user     User   @relation(fields: [userId], references: [id])
}

model LigaPrivada {
  id        String   @id @default(uuid())
  nombre    String
  codigo    String   @unique
  creadorId String

  creador   User     @relation("LigaCreador", fields: [creadorId], references: [id])
  miembros  User[]   @relation("LigaMiembros")
}

model Figurita {
  id            String   @id @default(cuid())
  numero        Int      @unique
  nombre        String
  pais          String
  paisCodigo    String
  posicion      String
  rareza        String
  datosCurioso  String?
  fechaNac      String?
  altura        String?
  peso          String?
  equipo        String?
  imagen        String?
  stats         Json?    @default("{}")
  colecciones   ColeccionFiguritas[]
}

model ColeccionFiguritas {
  id          String   @id @default(cuid())
  userId      String
  figuritaId  String
  cantidad    Int      @default(1)
  obtenidaEn  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  figurita    Figurita @relation(fields: [figuritaId], references: [id])
  @@unique([userId, figuritaId])
}

model TransaccionPuntos {
  id          String   @id @default(cuid())
  userId      String
  cantidad    Int
  tipo        String
  descripcion String
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id])
}
