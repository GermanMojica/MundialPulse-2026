
# ── Fútbol ──────────────────────
FOOTBALL_API_KEY=tu_token_de_football-data.org
FOOTBALL_API_SPORTS_KEY=tu_key_de_api-sports
FOOTBALL_API_SPORTS_URL=https://v3.football.api-sports.io/

# ── Base de datos ───────────────
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# ── Caché Redis ─────────────────
REDIS_URL=rediss://user:pass@host:port

# ── Auth ────────────────────────
JWT_SECRET=una_cadena_larga_y_aleatoria_aquí
PORT=5000

# ── Telegram ────────────────────
TELEGRAM_BOT_TOKEN=tu_bot_token_aqui
TELEGRAM_MAIN_CHANNEL_ID=tu_chat_id_aqui

# ── Push notifications ──────────
VAPID_PUBLIC_KEY=tu_public_key
VAPID_PRIVATE_KEY=tu_private_key
VAPID_EMAIL=admin@tuapp.com
